# ── Model API keys ────────────────────────────────────────────────────────────
# One key per connection defined in models.yaml.
# The variable name must match the "api_key_env" field for that connection.

ANTHROPIC_API_KEY=
# Single key for all capa connections (gpt-5.1-codex-mini, gpt-5.1-2, phi-4, qwen-3-4b).
# All four share the same resource and the same key.
AZURE_CAPA_API_KEY=

# Add more Azure connections as you add entries to models.yaml, e.g.:
# AZURE_EAST_API_KEY=

# NVIDIA integrate API (standalone personal account, not the capa Azure
# resource). Backup path added when Azure custom-model access was revoked —
# see DECISIONS.md's Operations entry for this connection.
NVIDIA_API_KEY=

# ── Active backend for live queries ───────────────────────────────────────────
# Must match an "id" in models.yaml. Used by the UI and run_query().
# The benchmark (make benchmark) ignores this — it runs all active connections.
# Options: gpt-5.1-codex-mini | gpt-5.1-2 | claude-sonnet (needs API credits)
#        | nvidia-kimi-k3 | nvidia-deepseek-v4-flash (inactive, see models.yaml)
MODEL_BACKEND=gpt-5.1-codex-mini

PG_HOST=
PG_PORT=
PG_DBNAME=
PG_USER=
PG_PASSWORD=

# Directory for persistent data (history, cache). Docker/cloud only — do not
# set for local development. docker_run.sh passes -e CANOPY_DATA_DIR=/data.
# Without this set, the app defaults to ~/.canopy and falls back to that path
# if the configured directory cannot be created.
# CANOPY_DATA_DIR=/data

# Hours before cached query results expire and are re-fetched from the model.
# Set to 0 to disable caching. Default: 24.
# CANOPY_CACHE_TTL_HOURS=24

# ── Scaling upgrade: DB pool, Redis cache, semantic SQL-plan cache ───────────
# Max psycopg2 connections in the pool (see DECISIONS.md O2). Default: 10.
# CANOPY_DB_POOL_SIZE=10

# Gradio per-handler concurrent query slots. Default: 3 (see DECISIONS.md O2).
# CANOPY_QUERY_CONCURRENCY_LIMIT=3

# Redis connection URL for the exact-match cache (canopy/cache.py). Unset =
# falls back to the file-based cache automatically — no other change needed.
# docker-compose.yml sets this to redis://redis:6379/0 for the compose stack.
# CANOPY_REDIS_URL=redis://localhost:6379/0

# Semantic SQL-plan cache (canopy/semantic_cache.py) — off by default. Requires
# CANOPY_REDIS_URL above to also be set; an incomplete config fails safe to
# "off" rather than raising. See DECISIONS.md for the 7-gate safety design.
# CANOPY_SEMANTIC_CACHE_ENABLED=true
# CANOPY_SEMANTIC_CACHE_THRESHOLD=0.93

# UI label language: en or es. Controls button labels and status messages only.
# Model responses auto-detect from question language independently. Default: en.
# CANOPY_UI_LANG=en

# Comma-separated list of column names to strip from model context before the
# result is returned. These columns are still visible in the UI Results tab.
# Default covers known sensitive fields; extend without a code deploy if new
# sensitive columns are added to the database.
# CANOPY_SENSITIVE_COLUMNS=latitude,longitude,hashed_password

# ── Langfuse tracing (online eval — dormant until Canopy has real traffic) ────
# Off by default. Requires ALL THREE to actually trace — an incomplete set
# fails safe into "no tracing" rather than crashing the query loop.
# NEVER set these in a test environment: traces must not leave the process
# during a test run. See DECISIONS.md's Operations section.
# CANOPY_LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ── A/B test: show SQL by default (see ~/Desktop/AB-Tests/ab-test-plan.md) ───
# Variant assignment is via PostHog feature flags (server-side SDK, not the
# JS wizard). Requires a project token AND a multivariate flag named
# canopy-show-sql-by-default with two variants (control, treatment). Off by
# default; also requires CANOPY_LANGFUSE_ENABLED=true above — an experiment
# with no way to assign variants (PostHog) or measure its primary metric
# (Langfuse) is not a running experiment. Do NOT turn CANOPY_AB_SHOW_SQL_ACTIVE
# on until file 06's online-eval baseline exists; see DECISIONS.md's "show
# SQL by default" entry.
# CANOPY_POSTHOG_API_KEY=
# CANOPY_POSTHOG_HOST=https://us.i.posthog.com
# CANOPY_AB_SHOW_SQL_ACTIVE=true